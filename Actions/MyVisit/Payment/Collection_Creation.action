{
	"_Type": "Action.Type.ODataService.CreateRelatedEntity",
	"ActionResult": {
		"_Name": "Collection_Creation"
	},
	"OnSuccess": "/LMD_MDKApp/Actions/MyVisit/Payment/Collection_Payment_Creation_Cash.action",
	"Target": {
		"Service": "/LMD_MDKApp/Services/LMD_MA.service",
		"EntitySet": "Collections"
	},
	"ParentLink": {
		"Target": {
			"EntitySet": "Stops",
			"ReadLink": "/LMD_MDKApp/Rules/Visit/Payment/Collection_VisitPaymentReadLink.js"
		},
		"Property": "to_Collections"
	},
	"Properties": {
		"CollectionID": "/LMD_MDKApp/Rules/Visit/Payment/GenerateCollectionID.js",
		"StopUUID": "/LMD_MDKApp/Rules/Visit/Payment/GetCurrentStopUUID.js",
		"CollectionDate": "/LMD_MDKApp/Rules/Checkout/TruckInfo/GetLastChangeTimeStamp.js",
		"Currency": "{#Control:VisitCurrencyInput/#Value}"
	},
	"Headers": {
		"OfflineOData.TransactionID": "#Property:RouteUUID"
	}
}