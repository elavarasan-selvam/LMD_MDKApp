{
	"_Type": "Action.Type.ODataService.Read",
	"ActionResult": {
		"_Name": "ReadRouteByUUID"
	},
	"OnFailure": "/LMD_MDKApp/Actions/Main/Routes/ReadlinkFailedforRouteStart.action",
	"OnSuccess": "/LMD_MDKApp/Rules/UpdateRouteUsingReadLink.js",
	"Target": {
		"Service": "/LMD_MDKApp/Services/DEST_SAMLMD_PPROP.service",
		"EntitySet": "Routes",
		"QueryOptions": "/LMD_MDKApp/Rules/Main/GetRouteFilter.js"
	},
	"Properties": [
		"RouteUUID",
		"RouteID",
		"MainDriverID",
		"CoDriverID",
		"OdometerBegin",
		"PlannedStartDateTime",
		"OdometerEnd",
		"PlannedEndDateTime",
		"StartDateTime",
		"EndDateTime"
	]
}