{
	"_Type": "Action.Type.ODataService.UpdateEntity",
	"ActionResult": {
		"_Name": "StartDateTime"
	},
	"OnSuccess": "/LMD_MDKApp/Actions/StartCheckout/NavToStartCheckout.action",
	"Target": {
		"Service": "/LMD_MDKApp/Services/LMD_MA.service",
		"EntitySet": "Routes",
		"ReadLink": "{{#Property:routeReadLink}}"
	},
	"Properties": {
		"StartDateTime": "{{#Property:StartDateTime}}"
	},
	"Headers": {
		"OfflineOData.TransactionID": "#Property:RouteUUID"
	},
	"RequestOptions": {
		"UpdateMode": "Merge"
	}
}